# cn-paperless — copy to .env (gitignored). The real .env is Kauket-managed:
#   kauket get kaiser.cn_paperless_env
# Comments must stay on their own lines (docker env files have no inline #).

# ── Tailnet sidecar (ts-docs, tag:svc) ──────────────────────────────────────
# Pre-auth key minted on the VPS (numeric user id, one-shot, short-lived):
#   ssh hs.gn.al 'docker exec cloudnet-headscale-1 headscale preauthkeys create --user 2 --tags tag:svc --expiration 1h'
DOCS_AUTHKEY=
HEADSCALE_DOMAIN=hs.gn.al
INFRA_VPS_TAILNET_IP=100.64.0.1

# ── Domains ─────────────────────────────────────────────────────────────────
LAN_DOMAIN=kaiser.lan
LAB_DOMAIN=lab.gn.al
TAILNET_DOMAIN=ts.gn.al

# ── Ops ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
TIMEZONE=America/Los_Angeles

# ── Postgres (superuser, created by the image on first init) ────────────────
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
# openssl rand -base64 24
PAPERLESS_DB_PASSWORD=

# ── Paperless ───────────────────────────────────────────────────────────────
# RETAINED material: signs sessions and CSRF tokens. Mint once (openssl rand
# -base64 48), never regenerate as a setup convenience.
PAPERLESS_SECRET_KEY=
# Break-glass superuser — created on the FIRST boot only; later edits to these
# two values are ignored by Paperless. Also what scripts/bootstrap.sh logs in as.
PAPERLESS_ADMIN_USER=admin
# Distinct from every person's e-mail (allauth will not auto-link an SSO login
# to a local account that owns the same address). First boot only.
PAPERLESS_ADMIN_MAIL=admin@docs.lab.gn.al
# openssl rand -base64 18
PAPERLESS_ADMIN_PASSWORD=
# tesseract languages for OCR (the image ships eng, spa, deu, fra, ita, …)
PAPERLESS_OCR_LANGUAGE=eng+spa
# true = the login page jumps straight to Authentik (keep false while local
# logins are still needed: break-glass admin, Android app, token minting)
PAPERLESS_REDIRECT_LOGIN_TO_SSO=false

# ── OIDC — printed by cn-authentik/setup-paperless-oidc.sh ──────────────────
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_URL=https://auth.lab.gn.al/application/o/paperless/.well-known/openid-configuration

# ── Metrics — API token of the `metrics` user, minted once by scripts/bootstrap.sh
# (setup.sh renders it into exporter/auth-token.txt for paperless-exporter)
PAPERLESS_METRICS_TOKEN=

# ── SMTP — shared homelab Mailgun (same values as other cn-* stacks) ────────
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=

# ── Backup — shared S3 + raidnas WebDAV ─────────────────────────────────────
BACKUP_S3_BUCKET=cloudnet-lab-storage
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-2
BACKUP_WEBDAV_URL=http://raidnas.lan:5005/cloudlabbackup
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
